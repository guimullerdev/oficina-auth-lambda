{
  "name": "oficina-auth-lambda",
  "version": "1.0.0",
  "description": "Function Serverless de autenticacao por CPF — Tech Challenge Fase 3",
  "private": true,
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --loader:.pem=text --outfile=dist/index.js",
    "package": "npm run build && cd dist && zip -qr ../function.zip index.js",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "moduleNameMapper": {
      "\\.pem$": "<rootDir>/test/pem-stub.ts"
    },
    "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.spec.ts"]
  }
}
